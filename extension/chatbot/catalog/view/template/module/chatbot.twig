<link rel="stylesheet" href="{{ base }}extension/chatbot/catalog/view/stylesheet/chatbot.css"/>
<div id="chatbot" class="chatbot" data-send="{{ send }}" data-product-search="{{ product_search }}" data-order-status="{{ order_status }}">
  <button type="button" class="chatbot-toggle" aria-label="{{ title }}">
    <span class="chatbot-icon chatbot-icon-open" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h3l4 4 4-4h5c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8.17L7 17.17 4 14.17V4h16v12z"/><path d="M7 9h10v2H7zm0-3h10v2H7zm0 6h7v2H7z"/></svg>
    </span>
    <span class="chatbot-icon chatbot-icon-close" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12l-4.89 4.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"/></svg>
    </span>
  </button>

  <div class="chatbot-window" role="dialog" aria-label="{{ title }}">
    <div class="chatbot-header">
      <div class="chatbot-header-title">
        <span class="chatbot-header-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h3l4 4 4-4h5c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        </span>
        <span class="chatbot-title">{{ title }}</span>
      </div>
      <button type="button" class="chatbot-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12l-4.89 4.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"/></svg>
      </button>
    </div>

    <div class="chatbot-body" id="chatbot-body">
      <div class="chatbot-msg chatbot-msg--bot">{{ greeting }}</div>
      <div class="chatbot-quick">
        {% if product_search %}<button type="button" class="chatbot-quick-btn" data-intent="__products">{{ text_quick_products }}</button>{% endif %}
        {% if order_status %}<button type="button" class="chatbot-quick-btn" data-intent="__order">{{ text_quick_order }}</button>{% endif %}
        <button type="button" class="chatbot-quick-btn" data-intent="__faq">{{ text_quick_faq }}</button>
      </div>
    </div>

    <form class="chatbot-input" id="chatbot-form" autocomplete="off">
      <input type="text" id="chatbot-text" class="chatbot-text" placeholder="{{ placeholder }}"/>
      <button type="submit" class="chatbot-send" aria-label="{{ text_send }}">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>
    </form>
  </div>
</div>
<script src="{{ base }}extension/chatbot/catalog/view/javascript/chatbot.js"></script>