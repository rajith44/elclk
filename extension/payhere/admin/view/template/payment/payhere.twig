{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payhere" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <div class="mb-4">
          {{ text_payhere|raw }}
        </div>
        <form id="form-payhere" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-merchant-id" class="col-sm-3 col-form-label">{{ entry_merchant_id }}</label>
            <div class="col-sm-9">
              <input type="text" name="payment_payhere_merchant_id" value="{{ payment_payhere_merchant_id }}" id="input-merchant-id" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-secret" class="col-sm-3 col-form-label">{{ entry_secret }}</label>
            <div class="col-sm-9">
              <input type="text" name="payment_payhere_secret" value="{{ payment_payhere_secret }}" id="input-secret" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_payhere_status" value="0"/>
                <input type="checkbox" name="payment_payhere_status" value="1" id="input-status" class="form-check-input"{% if payment_payhere_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_onsite_checkout }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_payhere_onsite_checkout" value="0"/>
                <input type="checkbox" name="payment_payhere_onsite_checkout" value="1" id="input-onsite" class="form-check-input"{% if payment_payhere_onsite_checkout %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_onsite_checkout }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_test }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_payhere_test" value="0"/>
                <input type="checkbox" name="payment_payhere_test" value="1" id="input-test" class="form-check-input"{% if payment_payhere_test %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_test }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-total" class="col-sm-3 col-form-label">{{ entry_total }}</label>
            <div class="col-sm-9">
              <input type="text" name="payment_payhere_total" value="{{ payment_payhere_total }}" id="input-total" class="form-control"/>
              <div class="form-text">{{ help_total }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-order-status" class="col-sm-3 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-9">
              <select name="payment_payhere_order_status_id" id="input-order-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_payhere_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-pending-status" class="col-sm-3 col-form-label">{{ entry_pending_status }}</label>
            <div class="col-sm-9">
              <select name="payment_payhere_pending_status_id" id="input-pending-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_payhere_pending_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-canceled-status" class="col-sm-3 col-form-label">{{ entry_canceled_status }}</label>
            <div class="col-sm-9">
              <select name="payment_payhere_canceled_status_id" id="input-canceled-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_payhere_canceled_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-failed-status" class="col-sm-3 col-form-label">{{ entry_failed_status }}</label>
            <div class="col-sm-9">
              <select name="payment_payhere_failed_status_id" id="input-failed-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_payhere_failed_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-chargeback-status" class="col-sm-3 col-form-label">{{ entry_chargeback_status }}</label>
            <div class="col-sm-9">
              <select name="payment_payhere_chargeback_status_id" id="input-chargeback-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_payhere_chargeback_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-3 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-9">
              <select name="payment_payhere_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0"{% if payment_payhere_geo_zone_id == 0 %} selected{% endif %}>{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_payhere_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-3 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-9">
              <input type="text" name="payment_payhere_sort_order" value="{{ payment_payhere_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}

