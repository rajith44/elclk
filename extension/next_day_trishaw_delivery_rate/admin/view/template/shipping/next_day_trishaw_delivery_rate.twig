{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" id="button-save-general" form="form-general" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{ button_save_general }}</button>
        <a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i> {{ button_back }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div id="alerts"></div>

    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapse-general" aria-expanded="true" style="cursor:pointer;">
        <h3 class="card-title mb-0">{{ text_general_settings }}</h3>
        <i class="fa-solid fa-angle-down"></i>
      </div>
      <div id="collapse-general" class="collapse show">
        <div class="card-body">
          <form id="form-general" action="{{ save }}" method="post" data-oc-toggle="ajax">
            <div class="row mb-3">
              <label for="input-title" class="col-sm-2 col-form-label">{{ entry_title }}</label>
              <div class="col-sm-10">
                <input type="text" name="shipping_next_day_trishaw_delivery_rate_title" value="{{ shipping_next_day_trishaw_delivery_rate_title }}" placeholder="{{ entry_title }}" id="input-title" class="form-control"/>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-default-weight" class="col-sm-2 col-form-label">{{ entry_default_weight }}</label>
              <div class="col-sm-4">
                <input type="number" step="0.01" min="0" name="shipping_next_day_trishaw_delivery_rate_default_weight" value="{{ shipping_next_day_trishaw_delivery_rate_default_weight }}" id="input-default-weight" class="form-control"/>
              </div>
              <label for="input-additional-weight" class="col-sm-2 col-form-label">{{ entry_additional_weight }}</label>
              <div class="col-sm-4">
                <input type="number" step="0.01" min="0.01" name="shipping_next_day_trishaw_delivery_rate_additional_weight" value="{{ shipping_next_day_trishaw_delivery_rate_additional_weight }}" id="input-additional-weight" class="form-control"/>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
              <div class="col-sm-4">
                <select name="shipping_next_day_trishaw_delivery_rate_tax_class_id" id="input-tax-class" class="form-select">
                  <option value="0"> --- </option>
                  {% for tax_class in tax_classes %}
                    <option value="{{ tax_class.tax_class_id }}" {% if tax_class.tax_class_id == shipping_next_day_trishaw_delivery_rate_tax_class_id %}selected="selected"{% endif %}>{{ tax_class.title }}</option>
                  {% endfor %}
                </select>
              </div>
              <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
              <div class="col-sm-4">
                <input type="number" name="shipping_next_day_trishaw_delivery_rate_sort_order" value="{{ shipping_next_day_trishaw_delivery_rate_sort_order }}" id="input-sort-order" class="form-control"/>
              </div>
            </div>
            <div class="row mb-0">
              <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="shipping_next_day_trishaw_delivery_rate_status" id="input-status" class="form-select">
                  <option value="1" {% if shipping_next_day_trishaw_delivery_rate_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0" {% if not shipping_next_day_trishaw_delivery_rate_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapse-rate" aria-expanded="true" style="cursor:pointer;">
        <h3 class="card-title mb-0">{{ text_rate_configuration }}</h3>
        <i class="fa-solid fa-angle-down"></i>
      </div>
      <div id="collapse-rate" class="collapse show">
        <div class="card-body">
          <div class="row">
            <div class="col-lg-3 mb-3 mb-lg-0">
              <div class="list-group" id="province-list">
                {% for province in provinces %}
                  <button type="button" class="list-group-item list-group-item-action {% if loop.first %}active{% endif %}" data-province="{{ province }}">{{ province }}</button>
                {% endfor %}
              </div>
            </div>
            <div class="col-lg-9">
              <div class="table-responsive">
                <table id="table-city-rates" class="table table-striped table-bordered align-middle">
                  <thead>
                    <tr>
                      <th>{{ column_city }}</th>
                      <th>{{ column_city_rate }}</th>
                      <th>{{ column_primary_weight_rate }}</th>
                      <th>{{ column_additional_weight_rate }}</th>
                      <th>{{ column_status }}</th>
                      <th>{{ column_default_method }}</th>
                      <th class="text-center">{{ column_action }}</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-city-rate-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ text_modal_title }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ button_close }}"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-4">{{ text_modal_subtitle }}</p>
        <form id="form-city-rate">
          <div class="mb-3">
            <label class="form-label">{{ column_city }}</label>
            <input type="text" id="modal-city-name" class="form-control" readonly>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="modal-city-rate" class="form-label">{{ column_city_rate }}</label>
              <input type="number" step="0.01" min="0" id="modal-city-rate" class="form-control">
            </div>
            <div class="col-md-6">
              <label for="modal-primary-weight-rate" class="form-label">{{ column_primary_weight_rate }}</label>
              <input type="number" step="0.01" min="0" id="modal-primary-weight-rate" class="form-control">
            </div>
            <div class="col-md-6">
              <label for="modal-additional-weight-rate" class="form-label">{{ column_additional_weight_rate }}</label>
              <input type="number" step="0.01" min="0" id="modal-additional-weight-rate" class="form-control">
            </div>
            <div class="col-md-6">
              <label for="modal-status" class="form-label">{{ column_status }}</label>
              <select id="modal-status" class="form-select">
                <option value="1">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" id="button-clear-modal" class="btn btn-outline-secondary">{{ button_clear }}</button>
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ button_close }}</button>
        <button type="button" id="button-apply-modal" class="btn btn-primary">{{ button_apply }}</button>
      </div>
    </div>
  </div>
</div>

{{ footer }}

<script type="text/javascript"><!--
(function ($) {
  const methodTitle = '{{ shipping_next_day_trishaw_delivery_rate_title ? shipping_next_day_trishaw_delivery_rate_title : heading_title }}';
  const defaultProvince = '{{ default_province }}';
  const initialCities = {{ initial_cities }};
  const getCitiesUrl = '{{ get_cities|replace({'&amp;':'&'}) }}';
  const saveCityUrl = '{{ save_city|replace({'&amp;':'&'}) }}';
  const saveSettingsUrl = '{{ save|replace({'&amp;':'&'}) }}';
  const invalidRateMessage = '{{ error_invalid_rate|e('js') }}';

  let currentProvince = defaultProvince;

  const $alerts = $('#alerts');
  const $provinceList = $('#province-list');
  const $cityTable = $('#table-city-rates');
  const $modal = $('#modal-city-rate-modal');
  const $modalCity = $('#modal-city-name');
  const $modalCityRate = $('#modal-city-rate');
  const $modalPrimaryRate = $('#modal-primary-weight-rate');
  const $modalAdditionalRate = $('#modal-additional-weight-rate');
  const $modalStatus = $('#modal-status');

  const cityTable = $cityTable.DataTable({
    data: [],
    columns: [
      {
        data: 'city'
      },
      {
        data: 'city_rate',
        render: function (data) {
          return parseFloat(data).toFixed(2);
        }
      },
      {
        data: 'primary_weight_rate',
        render: function (data) {
          return parseFloat(data).toFixed(2);
        }
      },
      {
        data: 'additional_weight_rate',
        render: function (data) {
          return parseFloat(data).toFixed(2);
        }
      },
      {
        data: 'status',
        render: function (data) {
          return data === '1' || data === 1 ? '<span class="badge bg-success">{{ text_enabled }}</span>' : '<span class="badge bg-secondary">{{ text_disabled }}</span>';
        },
        orderable: false
      },
      {
        data: 'status',
        render: function (data) {
          return data === '1' || data === 1 ? methodTitle : '<span class="text-muted">&mdash;</span>';
        },
        orderable: false
      },
      {
        data: null,
        orderable: false,
        className: 'text-center',
        render: function (data, type, row) {
          return '<button type="button" class="btn btn-sm btn-outline-primary button-edit-city" data-city="' + row.city.replace(/"/g, '&quot;') + '"><i class="fa-solid fa-pen-to-square"></i></button>';
        }
      }
    ],
    paging: false,
    searching: false,
    info: false,
    language: {
      emptyTable: '{{ text_no_cities }}'
    }
  });

  function showAlert(type, message) {
    $alerts.html(
      '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
        message +
        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
      '</div>'
    );
  }

  function refreshTable(rows) {
    cityTable.clear();
    cityTable.rows.add(rows);
    cityTable.draw();
  }

  function fetchProvinceCities(province) {
    currentProvince = province;

    $.ajax({
      url: getCitiesUrl,
      type: 'post',
      dataType: 'json',
      data: { province: province },
      beforeSend: function () {
        cityTable.clear().draw();
      },
      success: function (json) {
        if (json.error) {
          showAlert('danger', json.error);
          return;
        }

        refreshTable(json.cities || []);
      },
      error: function (xhr) {
        showAlert('danger', xhr.statusText);
      }
    });
  }

  function openModal(rowData) {
    $modalCity.val(rowData.city);
    $modalCityRate.val(parseFloat(rowData.city_rate).toFixed(2));
    $modalPrimaryRate.val(parseFloat(rowData.primary_weight_rate).toFixed(2));
    $modalAdditionalRate.val(parseFloat(rowData.additional_weight_rate).toFixed(2));
    $modalStatus.val(String(rowData.status));
    $modal.data('city', rowData.city);
    $modal.modal('show');
  }

  function getRowByCity(city) {
    const data = cityTable.rows().data().toArray();
    return data.find(row => row.city === city) || null;
  }

  $('#button-save-general').on('click', function () {
    $.ajax({
      url: saveSettingsUrl,
      type: 'post',
      dataType: 'json',
      data: $('#form-general').serialize(),
      success: function (json) {
        if (json.error) {
          showAlert('danger', json.error);
        }

        if (json.success) {
          showAlert('success', json.success);
        }
      },
      error: function (xhr) {
        showAlert('danger', xhr.statusText);
      }
    });
  });

  $provinceList.on('click', 'button', function () {
    $provinceList.find('button').removeClass('active');
    $(this).addClass('active');
    fetchProvinceCities($(this).data('province'));
  });

  $cityTable.on('click', '.button-edit-city', function () {
    const city = $(this).data('city');
    const row = getRowByCity(city);

    if (row) {
      openModal(row);
    }
  });

  $('#button-clear-modal').on('click', function () {
    $modalCityRate.val('0.00');
    $modalPrimaryRate.val('0.00');
    $modalAdditionalRate.val('0.00');
    $modalStatus.val('1');
  });

  $('#button-apply-modal').on('click', function () {
    const cityRateValue = parseFloat($modalCityRate.val());
    const primaryRateValue = parseFloat($modalPrimaryRate.val());
    const additionalRateValue = parseFloat($modalAdditionalRate.val());

    if (Number.isNaN(cityRateValue) || Number.isNaN(primaryRateValue) || Number.isNaN(additionalRateValue)) {
      showAlert('danger', invalidRateMessage);
      return;
    }

    const payload = {
      province: currentProvince,
      city: $modalCity.val(),
      city_rate: cityRateValue.toFixed(2),
      primary_weight_rate: primaryRateValue.toFixed(2),
      additional_weight_rate: additionalRateValue.toFixed(2),
      status: $modalStatus.val()
    };

    $.ajax({
      url: saveCityUrl,
      type: 'post',
      dataType: 'json',
      data: payload,
      success: function (json) {
        if (json.error) {
          showAlert('danger', json.error);
          return;
        }

        if (json.success) {
          showAlert('success', json.success);
        }

        fetchProvinceCities(currentProvince);
        $modal.modal('hide');
      },
      error: function (xhr) {
        showAlert('danger', xhr.statusText);
      }
    });
  });

  // Bootstrap modal fallback for OC <= 4.1
  if (!$modal.modal) {
    $modal.on('show.bs.modal', function () {});
  }

  // Populate initial data on load
  if (Array.isArray(initialCities) && initialCities.length) {
    refreshTable(initialCities);
  } else if (defaultProvince) {
    fetchProvinceCities(defaultProvince);
  }
})(window.jQuery);
//--></script>

