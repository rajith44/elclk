{% if journal3.version_compare(constant('VERSION'), '4.0.1.1', '<=') %}
<form id="form-shipping-method">
  <fieldset>
    <legend>{{ heading_title }}</legend>
    <div id="shipping-methods-container">
      {% for shipping_method in shipping_methods %}
        <p><strong>{{ shipping_method.title }}</strong></p>
        {% if not shipping_method.error %}
          {% for quote in shipping_method.quote %}
            {% set _code = quote.code %}
            <div class="form-check">
              <input type="radio" class="form-check-input" name="shipping_method" value="{{ _code }}" id="input-shipping-method-{{ _code|replace({'.':'-'}) }}"{% if _code == code %} checked{% endif %}/>
              <label class="form-check-label" for="input-shipping-method-{{ _code|replace({'.':'-'}) }}">{{ quote.title }}{% if quote.cost %} - {{ quote.text }}{% endif %}</label>
            </div>
          {% endfor %}
        {% else %}
          <div class="alert alert-danger">{{ shipping_method.error }}</div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="mt-2" style="display: none;">
      <button type="button" id="button-shipping-method" class="btn btn-light"><i class="fa-solid fa-rotate fa fa-refresh"></i> {{ button_choose }}</button>
    </div>
  </fieldset>
</form>
<script type="text/javascript"><!--
// Shipping Methods
$('#button-shipping-method').on('click', function () {
    var element = this;

    chain.attach(function () {
        return $.ajax({
            url: 'index.php?route=checkout/shipping_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}getMethods&language={{ language }}',
            dataType: 'json',
            beforeSend: function () {
                $(element).prop('disabled', true);
            },
            complete: function () {
                $(element).prop('disabled', false);
            },
            success: function (json) {
                console.log(json);

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }

                var html = '';
                if (json['shipping_methods']) {
                    for (i in json['shipping_methods']) {
                        html += '<p><strong>' + json['shipping_methods'][i]['title'] + '</strong></p>';

                        if (!json['shipping_methods'][i]['error']) {
                            for (j in json['shipping_methods'][i]['quote']) {
                                var text = json['shipping_methods'][i]['quote'][j]['title'];
                                if (json['shipping_methods'][i]['quote'][j]['cost']) {
                                    text += ' - ' + json['shipping_methods'][i]['quote'][j]['text'];
                                }
                                var id = 'input-shipping-method-' + json['shipping_methods'][i]['quote'][j]['code'].replaceAll('.', '-').replaceAll('_', '-');
                                html += '<div class="form-check">';
                                html += '  <input type="radio" class="form-check-input" name="shipping_method" value="' + json['shipping_methods'][i]['quote'][j]['code'] + '" id="' + id + '"/>';
                                html += '  <label class="form-check-label" for="' + id + '">' + text + '</label>';
                                html += '</div>';
                            }
                        } else {
                            html += '<div class="alert alert-danger">' + json['shipping_methods'][i]['error'] + '</div>';
                        }
                    }
                }

                $('#shipping-methods-container').html(html);

                $('#checkout-confirm').load('index.php?route=checkout/confirm{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}confirm&language={{ language }}');
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

// Save selected shipping method on change
$(document).on('change', 'input[name="shipping_method"]', function () {
    var element = this;
    console.log('hit me 1');

    chain.attach(function () {
        return $.ajax({
            url: 'index.php?route=checkout/shipping_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}save&language={{ language }}',
            type: 'post',
            data: $('#form-shipping-method').serialize(),
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            beforeSend: function () {
                $(element).prop('disabled', true);
            },
            complete: function () {
                $(element).prop('disabled', false);
            },
            success: function (json) {
                console.log(json);

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }

                if (json['success']) {
                    $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                    $('#button-payment-method').trigger('click');
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});
//--></script>
{% else %}
<fieldset>
  <legend style="line-height: 0;">{{ heading_title }}</legend>
  <div class="input-group" style="display: none;">
    <span class="input-group-text"><i class="fa fa-truck"></i></span><input type="text" name="shipping_method" value="{{ shipping_method }}" placeholder="{{ entry_shipping_method }}" id="input-shipping-method" class="form-control" readonly/>
    <button type="button" id="button-shipping-method" class="btn btn-primary">{{ button_choose }}</button>
  </div>
  <input type="hidden" name="code" value="{{ code }}" id="input-shipping-code"/>
  <div id="error-shipping-method" class="invalid-feedback" style="display: none;">></div>
</fieldset>
<div id="shipping-methods-inline"></div>
<script type="text/javascript"><!--
$('#button-shipping-method').on('click', function() {
    var element = this;

    chain.attach(function() {
        return $.ajax({
            url: 'index.php?route=checkout/shipping_method.quote&language={{ language }}',
            dataType: 'json',
            beforeSend: function() {
                $(element).button('loading');
            },
            complete: function() {
                $(element).button('reset');
            },
            success: function(json) {
                console.log(json);

                $('#input-shipping-method').removeClass('is-invalid');
                $('#error-shipping-method').removeClass('d-block');

                if (json['error']) {
                    $('#input-shipping-method').addClass('is-invalid');
                    $('#error-shipping-method').html(json['error']).addClass('d-block');
                }

                if (json['shipping_methods']) {
                    var html = '<p>{{ text_shipping }}</p>';

                    for (i in json['shipping_methods']) {
                        html += '<p style="margin-top: 15px;"><strong>' + json['shipping_methods'][i]['name'] + '</strong></p>';

                        if (!json['shipping_methods'][i]['error']) {
                            for (j in json['shipping_methods'][i]['quote']) {
                                var code = i + '-' + j.replaceAll('_', '-');
                                html += '<div class="form-check">';
                                html += '  <input type="radio" name="shipping_method" value="' + json['shipping_methods'][i]['quote'][j]['code'] + '" id="input-shipping-method-' + code + '"';
                                if (json['shipping_methods'][i]['quote'][j]['code'] == '{{ code }}') {
                                    html += ' checked';
                                }
                                html += '/>';
                                html += '  <label for="input-shipping-method-' + code + '">' + json['shipping_methods'][i]['quote'][j]['name'] + ' - ' + json['shipping_methods'][i]['quote'][j]['text'] + '</label>';
                                html += '</div>';
                            }
                        } else {
                            html += '<div class="alert alert-danger">' + json['shipping_methods'][i]['error'] + '</div>';
                        }
                    }

                    $('#shipping-methods-inline').html(html);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

$(document).on('change', 'input[name="shipping_method"]', function() {
    var element = this; 
    chain.attach(function() {
        return $.ajax({ 
            url: 'index.php?route=checkout/shipping_method.save&language={{ language }}',
            type: 'post',
            data: { shipping_method: element.value },
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            beforeSend: function() {
                $(element).prop('disabled', true);
            },
            complete: function() {
                $(element).prop('disabled', false);
            },
            success: function(json) {
                console.log(json);

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }

                if (json['success']) {
                    $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                    $('#modal-shipping').modal('hide');

                    $('#input-shipping-method').val($('input[name=\'shipping_method\']:checked').parent().find('label').text());
                    $('#input-shipping-code').val($('input[name=\'shipping_method\']:checked').val());

                    $('#input-payment-method').val('');

                    $('#checkout-confirm').load('index.php?route=checkout/confirm.confirm&language={{ language }}');
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});
//--></script>
{% endif %}
