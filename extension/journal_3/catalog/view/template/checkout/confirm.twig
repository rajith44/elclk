<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <td class="text-start">{{ column_name }}</td>
        <td class="text-center">{{ column_total }}</td>
      </tr>
    </thead>
    <tbody>
      {% for product in products %}
        <tr>
          <td class="text-start">
            <div class="checkout-cart-item">
              <span>{{ product.quantity }}<small>x</small></span>
              <span>
              <a href="{{ product.href }}">{{ product.name }}</a>
              {% for option in product.option %}
                <br/>
                <small> &#8226; {{ option.name }}: {{ option.value }}</small>
              {% endfor %}
                {% if product.subscription %}
                  <br/>
                  <small>{{ text_subscription }} {{ product.subscription }}</small>
                {% endif %}
            </span>
            </div>
          </td>
          <td class="text-end">{{ product.total }}</td>
        </tr>
      {% endfor %}
      {% for voucher in vouchers %}
        <tr>
          <td class="text-start">1x {{ voucher.description }}</td>
          <td class="text-end">{{ voucher.amount }}</td>
        </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      {% for total in totals %}
        <tr>
          <td class="text-end"><strong>{{ total.title }}</strong></td>
          <td class="text-end">{{ total.text }}</td>
        </tr>
      {% endfor %}
    </tfoot>
  </table>
</div>
<div class="mb-3" id="checkout-newsletter-agree">
  <div class="form-check checkbox mb-2">
    <input type="checkbox" name="newsletter" value="1" id="input-newsletter-confirm" class="form-check-input"/>
    <label for="input-newsletter-confirm" class="form-check-label" id="label-newsletter-confirm">I wish to subscribe to the newsletter</label>
  </div>
  <div class="form-check checkbox mb-2" id="agree-wrapper-confirm">
    <input type="checkbox" name="agree" value="1" id="input-register-agree-confirm" class="form-check-input"/>
    <label for="input-register-agree-confirm" class="form-check-label" id="label-agree-confirm">I have read and agree to the Privacy Policy</label>
  </div>
</div>
<script type="text/javascript"><!--
// Load newsletter and agree text from existing sections or via AJAX
function loadCheckboxTexts() {
    // Try to get newsletter text from register section
    var newsletterLabel = $('#checkout-register #input-newsletter').next('label');
    if (newsletterLabel.length && newsletterLabel.text().trim()) {
        $('#label-newsletter-confirm').text(newsletterLabel.text());
    }
    
    // Try to get agree text from payment method section (multiple selectors)
    var agreeLabel = null;
    
    // Try different selectors
    agreeLabel = $('#checkout-payment-method #input-checkout-agree').closest('.form-check, .form-switch').find('label').first();
    if (!agreeLabel.length || !agreeLabel.html() || !agreeLabel.html().trim()) {
        agreeLabel = $('#checkout-payment-method #input-agree').closest('.form-check, .form-switch').find('label').first();
    }
    if (!agreeLabel.length || !agreeLabel.html() || !agreeLabel.html().trim()) {
        agreeLabel = $('#checkout-payment-method label[for="input-checkout-agree"], #checkout-payment-method label[for="input-agree"]').first();
    }
    
    if (agreeLabel.length && agreeLabel.html() && agreeLabel.html().trim()) {
        $('#label-agree-confirm').html(agreeLabel.html());
        updateConfirmButton();
    } else {
        // Load from payment_method controller if not found
        chain.attach(function() {
            return $.ajax({
                url: 'index.php?route=checkout/payment_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}index&language={{ language }}',
                dataType: 'html',
                success: function(html) {
                    var $temp = $('<div>').html(html);
                    var agreeText = null;
                    
                    // Try multiple selectors
                    agreeText = $temp.find('#input-checkout-agree').closest('.form-check, .form-switch').find('label').first().html();
                    if (!agreeText || !agreeText.trim()) {
                        agreeText = $temp.find('#input-agree').closest('.form-check, .form-switch').find('label').first().html();
                    }
                    if (!agreeText || !agreeText.trim()) {
                        agreeText = $temp.find('label[for="input-checkout-agree"], label[for="input-agree"]').first().html();
                    }
                    
                    if (agreeText && agreeText.trim()) {
                        $('#label-agree-confirm').html(agreeText);
                        updateConfirmButton();
                    }
                }
            });
        });
    }
}

$(document).ready(function() {
    // Try immediately
    loadCheckboxTexts();
    
    // Try again after a delay in case sections load dynamically
    setTimeout(loadCheckboxTexts, 500);
    setTimeout(loadCheckboxTexts, 1500);
});
//--></script>
<div id="checkout-payment">
  {% if payment %}
    {{ payment }}
  {% else %}
    <div class="text-end"><button type="button" id="button-confirm" class="btn btn-primary" disabled>{{ button_confirm }}</button></div>
  {% endif %}
</div>
<script type="text/javascript"><!--
// Newsletter handler - saves to session
$(document).on('change', '#input-newsletter-confirm', function () {
    var element = this;

    chain.attach(function () {
        return $.ajax({
            url: 'index.php?route=checkout/register{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}save&language={{ language }}',
            type: 'post',
            data: {
                newsletter: $(element).is(':checked') ? '1' : '0'
            },
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            beforeSend: function () {
                $(element).prop('disabled', true);
            },
            complete: function () {
                $(element).prop('disabled', false);
            },
            success: function (json) {
                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

// Privacy Agree handler - updates confirm section and enables/disables confirm button
function updateConfirmButton() {
    if ($('#input-register-agree-confirm').length && $('#input-register-agree-confirm').is(':checked')) {
        $('#button-confirm').prop('disabled', false);
    } else if ($('#input-register-agree-confirm').length) {
        $('#button-confirm').prop('disabled', true);
    } else {
        $('#button-confirm').prop('disabled', false);
    }
}

$(document).on('change', '#input-register-agree-confirm', function () {
    var element = this;
    updateConfirmButton();

    chain.attach(function () {
        return $.ajax({
            url: 'index.php?route=checkout/payment_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}agree&language={{ language }}',
            type: 'post',
            data: {
                agree: $(element).is(':checked') ? '1' : '0'
            },
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            beforeSend: function () {
                $(element).prop('disabled', true);
            },
            complete: function () {
                $(element).prop('disabled', false);
            },
            success: function (json) {
                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }

                if (json['success']) {
                    $('#checkout-confirm').load('index.php?route=checkout/confirm{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}confirm&language={{ language }}');
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

// Initialize confirm button state on page load
updateConfirmButton();

// Validate all required fields in register form before submission
function validateRegisterForm() {
    var errors = [];
    var hasErrors = false;
    
    // Clear previous error messages
    $('.invalid-feedback').html('').removeClass('d-block');
    $('.form-control, .form-select').removeClass('is-invalid');
    
    // Check if register section is visible (not guest checkout)
    var accountType = $('input[name="account"]:checked').val();
    var isRegister = (accountType == '1' || accountType == 1);
    var isGuest = (accountType == '0' || accountType == 0);
    
    // Validate account type
    if (!accountType || accountType == 'login') {
        errors.push('Please select an account type');
        hasErrors = true;
    }
    
    // Validate required account fields (for both register and guest)
    if (!isRegister || isGuest) {
        // Firstname
        var firstname = $('#input-firstname').val().trim();
        if (!firstname || firstname.length < 1 || firstname.length > 32) {
            $('#input-firstname').addClass('is-invalid');
            $('#error-firstname').html('First name must be between 1 and 32 characters!').addClass('d-block');
            errors.push('First name is required');
            hasErrors = true;
        }
        
        // Lastname
        var lastname = $('#input-lastname').val().trim();
        if (!lastname || lastname.length < 1 || lastname.length > 32) {
            $('#input-lastname').addClass('is-invalid');
            $('#error-lastname').html('Last name must be between 1 and 32 characters!').addClass('d-block');
            errors.push('Last name is required');
            hasErrors = true;
        }
        
        // Email
        var email = $('#input-email').val().trim();
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email)) {
            $('#input-email').addClass('is-invalid');
            $('#error-email').html('E-Mail Address does not appear to be valid!').addClass('d-block');
            errors.push('Valid email is required');
            hasErrors = true;
        }
        
        // Telephone (if required)
        if ($('#input-telephone').closest('.required').length || $('#input-telephone').closest('.form-group').hasClass('required')) {
            var telephone = $('#input-telephone').val().trim();
            if (!telephone || telephone.length < 3 || telephone.length > 32) {
                $('#input-telephone').addClass('is-invalid');
                $('#error-telephone').html('Telephone must be between 3 and 32 characters!').addClass('d-block');
                errors.push('Telephone is required');
                hasErrors = true;
            }
        }
    }
    
    // Validate payment address fields (if payment address is required)
    if ($('#input-payment-address-1').length) {
        // Address 1
        var paymentAddress1 = $('#input-payment-address-1').val().trim();
        if ($('#input-payment-address-1').closest('.required').length || $('#input-payment-address-1').closest('.form-group').hasClass('required')) {
            if (!paymentAddress1 || paymentAddress1.length < 3 || paymentAddress1.length > 128) {
                $('#input-payment-address-1').addClass('is-invalid');
                $('#error-payment-address-1').html('Address must be between 3 and 128 characters!').addClass('d-block');
                errors.push('Payment address is required');
                hasErrors = true;
            }
        }
        
        // City
        var paymentCity = $('#input-payment-city').val().trim();
        if ($('#input-payment-city').closest('.required').length || $('#input-payment-city').closest('.form-group').hasClass('required')) {
            if (!paymentCity || paymentCity.length < 2 || paymentCity.length > 128) {
                $('#input-payment-city').addClass('is-invalid');
                $('#error-payment-city').html('City must be between 2 and 128 characters!').addClass('d-block');
                errors.push('Payment city is required');
                hasErrors = true;
            }
        }
        
        // Country
        var paymentCountry = $('#input-payment-country').val();
        if ($('#input-payment-country').closest('.required').length || $('#input-payment-country').closest('.form-group').hasClass('required')) {
            if (!paymentCountry || paymentCountry == '') {
                $('#input-payment-country').addClass('is-invalid');
                $('#error-payment-country').html('Please select a country!').addClass('d-block');
                errors.push('Payment country is required');
                hasErrors = true;
            }
        }
        
        // Zone
        var paymentZone = $('#input-payment-zone').val();
        if ($('#input-payment-zone').closest('.required').length || $('#input-payment-zone').closest('.form-group').hasClass('required')) {
            if (!paymentZone || paymentZone == '') {
                $('#input-payment-zone').addClass('is-invalid');
                $('#error-payment-zone').html('Please select a region / state!').addClass('d-block');
                errors.push('Payment zone is required');
                hasErrors = true;
            }
        }
        
        // Postcode (if required by country)
        var paymentPostcode = $('#input-payment-postcode').val().trim();
        if ($('#input-payment-postcode').closest('.required').length || $('#input-payment-postcode').closest('.form-group').hasClass('required')) {
            if (!paymentPostcode || paymentPostcode.length < 2 || paymentPostcode.length > 10) {
                $('#input-payment-postcode').addClass('is-invalid');
                $('#error-payment-postcode').html('Postcode must be between 2 and 10 characters!').addClass('d-block');
                errors.push('Payment postcode is required');
                hasErrors = true;
            }
        }
    }
    
    // Validate shipping address fields (if shipping is required and address match is not checked)
    var addressMatch = $('#input-address-match').is(':checked');
    if (!$('#input-address-match').length || !addressMatch) {
        if ($('#input-shipping-address-1').length) {
            // Shipping Address 1
            var shippingAddress1 = $('#input-shipping-address-1').val().trim();
            if ($('#input-shipping-address-1').closest('.required').length || $('#input-shipping-address-1').closest('.form-group').hasClass('required')) {
                if (!shippingAddress1 || shippingAddress1.length < 3 || shippingAddress1.length > 128) {
                    $('#input-shipping-address-1').addClass('is-invalid');
                    $('#error-shipping-address-1').html('Address must be between 3 and 128 characters!').addClass('d-block');
                    errors.push('Shipping address is required');
                    hasErrors = true;
                }
            }
            
            // Shipping City
            var shippingCity = $('#input-shipping-city').val().trim();
            if ($('#input-shipping-city').closest('.required').length || $('#input-shipping-city').closest('.form-group').hasClass('required')) {
                if (!shippingCity || shippingCity.length < 2 || shippingCity.length > 128) {
                    $('#input-shipping-city').addClass('is-invalid');
                    $('#error-shipping-city').html('City must be between 2 and 128 characters!').addClass('d-block');
                    errors.push('Shipping city is required');
                    hasErrors = true;
                }
            }
            
            // Shipping Country
            var shippingCountry = $('#input-shipping-country').val();
            if ($('#input-shipping-country').closest('.required').length || $('#input-shipping-country').closest('.form-group').hasClass('required')) {
                if (!shippingCountry || shippingCountry == '') {
                    $('#input-shipping-country').addClass('is-invalid');
                    $('#error-shipping-country').html('Please select a country!').addClass('d-block');
                    errors.push('Shipping country is required');
                    hasErrors = true;
                }
            }
            
            // Shipping Zone
            var shippingZone = $('#input-shipping-zone').val();
            if ($('#input-shipping-zone').closest('.required').length || $('#input-shipping-zone').closest('.form-group').hasClass('required')) {
                if (!shippingZone || shippingZone == '') {
                    $('#input-shipping-zone').addClass('is-invalid');
                    $('#error-shipping-zone').html('Please select a region / state!').addClass('d-block');
                    errors.push('Shipping zone is required');
                    hasErrors = true;
                }
            }
        }
    }
    
    // Validate required custom fields
    $('.custom-field.required').each(function() {
        var $field = $(this);
        var fieldId = $field.find('input, select, textarea').first().attr('id');
        var fieldValue = $field.find('input[type="radio"]:checked, input[type="checkbox"]:checked, select, input[type="text"], input[type="hidden"], textarea').val();
        
        if (!fieldValue || (Array.isArray(fieldValue) && fieldValue.length === 0)) {
            $field.find('input, select, textarea').first().addClass('is-invalid');
            var errorDiv = $field.find('.invalid-feedback').first();
            if (errorDiv.length) {
                errorDiv.html('This field is required!').addClass('d-block');
            }
            errors.push('Custom field is required');
            hasErrors = true;
        }
    });
    
    // Validate password if account type is register
    if (isRegister) {
        var password = $('#input-password').val();
        if ($('#input-password').length && $('#input-password').closest('.required').length) {
            if (!password || password.length < 4) {
                $('#input-password').addClass('is-invalid');
                $('#error-password').html('Password must be at least 4 characters!').addClass('d-block');
                errors.push('Password is required');
                hasErrors = true;
            }
        }
    }
    
    // Validate privacy agree checkbox
    if (!$('#input-register-agree-confirm').is(':checked')) {
        errors.push('You must agree to the Privacy Policy');
        hasErrors = true;
        $('#input-register-agree-confirm').closest('.form-check').addClass('text-danger');
    } else {
        $('#input-register-agree-confirm').closest('.form-check').removeClass('text-danger');
    }
    
    // Show error alert if there are errors
    if (hasErrors) {
        var errorMessage = 'Please correct the following errors:<br/>' + errors.join('<br/>');
        $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + errorMessage + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        
        // Scroll to first error
        var firstError = $('.is-invalid').first();
        if (firstError.length) {
            $('html, body').animate({
                scrollTop: firstError.offset().top - 100
            }, 500);
        }
    }
    
    return !hasErrors;
}

// Intercept confirm button click to validate before submission
$(document).on('click', '#button-confirm', function(e) {
    // Validate register form first
    if (!validateRegisterForm()) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }
    
    // If validation passes, allow the normal payment method handler to proceed
    // The payment method extension will handle the actual submission
});
//--></script>
