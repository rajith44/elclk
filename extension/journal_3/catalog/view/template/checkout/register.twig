// City change handlers - trigger form submission and reload shipping methods
var cityChangeTimeout = null;
var shippingCityChangeTimeout = null;

function handleCityChange() {
    // Clear any existing timeout
    if (cityChangeTimeout) {
        clearTimeout(cityChangeTimeout);
    }
    
    // Debounce the city change - wait 800ms after user stops typing
    cityChangeTimeout = setTimeout(function() {
        // Check if required fields are filled before submitting
        var paymentCity = $('#input-payment-city').val() && $('#input-payment-city').val().trim() !== '';
        var paymentCountry = $('#input-payment-country').val() && $('#input-payment-country').val() !== '';
        var paymentZone = $('#input-payment-zone').val() && $('#input-payment-zone').val() !== '';
        
        if (paymentCity && paymentCountry && paymentZone) {
            // Submit register form to save address
            submitRegisterForm();
        }
    }, 800);
}

function handleShippingCityChange() {
    // Clear any existing timeout
    if (shippingCityChangeTimeout) {
        clearTimeout(shippingCityChangeTimeout);
    }
    
    // Debounce the shipping city change
    shippingCityChangeTimeout = setTimeout(function() {
        // Check if required shipping fields are filled
        var shippingCity = $('#input-shipping-city').val() && $('#input-shipping-city').val().trim() !== '';
        var shippingCountry = $('#input-shipping-country').val() && $('#input-shipping-country').val() !== '';
        var shippingZone = $('#input-shipping-zone').val() && $('#input-shipping-zone').val() !== '';
        
        if (shippingCity && shippingCountry && shippingZone) {
            // Submit register form first
            submitRegisterForm();
            
            // Then reload shipping methods
            {% if shipping_required %}
            setTimeout(function() {
                if ($('#button-shipping-method').length) {
                    $('#button-shipping-method').trigger('click');
                } else {
                    // Reload shipping method section
                    $('#checkout-shipping-method').load('index.php?route=checkout/shipping_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}index&language={{ language }}');
                }
            }, 1500);
            {% endif %}
        }
    }, 800);
}

// Payment city change - handle both input and change events
$('#input-payment-city').on('input change blur', function() {
    handleCityChange();
});

// Shipping city change - handle both input and change events
$('#input-shipping-city').on('input change blur', function() {
    handleCityChange(); // Also submit form
    handleShippingCityChange(); // And reload shipping methods
});

