    var shippingCountry = $('#input-shipping-country').val() && $('#input-shipping-country').val() !== '';
    var shippingAddress1 = $('#input-shipping-address-1').val() && $('#input-shipping-address-1').val().trim() !== '';
    
    // If all required fields are filled, submit form and reload shipping methods
    if (shippingCity && shippingCountry && shippingZone && shippingAddress1) {
