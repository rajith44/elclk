</form>
<script type="text/javascript"><!--
// Account
function toggleAccountOptions() {
    var selected = $('input[name=\'account\']:checked').val();

    if (selected == '1') {
        $('#password').removeClass('d-none');
    } else {
        // If guest hide password field
        $('#password').addClass('d-none');
    }

    if (selected == 'login') {
        $('#register-section').addClass('d-none');
        $('#returning-customer').removeClass('d-none');
    } else {
        $('#register-section').removeClass('d-none');
        $('#returning-customer').addClass('d-none');
    }
}

$('input[name=\'account\']').on('change', toggleAccountOptions);
toggleAccountOptions();

$('input[name=\'account\']:checked').trigger('click');

// Customer Group
$('#input-customer-group').on('change', function () {
    var element = this;

    chain.attach(function () {
        return $.ajax({
            url: 'index.php?route=account/custom_field&language={{ language }}&customer_group_id=' + $(element).val(),
            dataType: 'json',
            beforeSend: function () {
                $(element).prop('disabled', true);
            },
            complete: function () {
                $(element).prop('disabled', false);
            },
            success: function (json) {
                $('.custom-field').addClass('d-none');
                $('.custom-field').removeClass('required');

                for (i = 0; i < json.length; i++) {
                    custom_field = json[i];

                    $('.custom-field-' + custom_field['custom_field_id']).removeClass('d-none');

                    if (custom_field['required']) {
                        $('.custom-field-' + custom_field['custom_field_id']).addClass('required');
                    }
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

$('#input-customer-group').trigger('change');

$('#input-address-match').on('change', function () {
    if ($(this).prop('checked')) {
        $('#shipping-address').hide();
    } else {
        $('#shipping-address').show();
    }
});

// Comprehensive validation function for all checkout fields
function validateAllCheckoutFields() {
    var errors = [];
    var hasErrors = false;
    
    // Clear previous error messages
    $('#form-register .invalid-feedback').html('').removeClass('d-block');
    $('#form-register .form-control, #form-register .form-select').removeClass('is-invalid');
    $('#form-register .has-error').removeClass('has-error');
    
    // Check account type
    var accountType = $('input[name="account"]:checked').val();
    var isRegister = (accountType == '1' || accountType == 1);
    var isGuest = (accountType == '0' || accountType == 0);
    
    if (!accountType || accountType == 'login') {
        errors.push('Please select an account type');
        hasErrors = true;
    }
    
    // Validate required account fields (for both register and guest)
    if (isRegister || isGuest) {
        // Firstname
        var firstname = $('#input-firstname').val();
        if (!firstname || firstname.trim().length < 1 || firstname.trim().length > 32) {
            $('#input-firstname').addClass('is-invalid');
            $('#error-firstname').html('First name must be between 1 and 32 characters!').addClass('d-block');
            $('#input-firstname').closest('.required').addClass('has-error');
            errors.push('First name is required');
            hasErrors = true;
        }
        
        // Lastname
        var lastname = $('#input-lastname').val();
        if (!lastname || lastname.trim().length < 1 || lastname.trim().length > 32) {
            $('#input-lastname').addClass('is-invalid');
            $('#error-lastname').html('Last name must be between 1 and 32 characters!').addClass('d-block');
            $('#input-lastname').closest('.required').addClass('has-error');
            errors.push('Last name is required');
            hasErrors = true;
        }
        
        // Email
        var email = $('#input-email').val();
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email.trim())) {
            $('#input-email').addClass('is-invalid');
            $('#error-email').html('E-Mail Address does not appear to be valid!').addClass('d-block');
            $('#input-email').closest('.required').addClass('has-error');
            errors.push('Valid email is required');
            hasErrors = true;
        }
        
        // Telephone (if required)
        if ($('#input-telephone').closest('.required').length || $('#input-telephone').closest('.form-group').hasClass('required')) {
            var telephone = $('#input-telephone').val();
            if (!telephone || telephone.trim().length < 3 || telephone.trim().length > 32) {
                $('#input-telephone').addClass('is-invalid');
                $('#error-telephone').html('Telephone must be between 3 and 32 characters!').addClass('d-block');
                $('#input-telephone').closest('.required, .form-group').addClass('has-error');
                errors.push('Telephone is required');
                hasErrors = true;
            }
        }
    }
    
    // Validate payment address fields (if payment address section exists)
    if ($('#input-payment-address-1').length) {
        // Address 1
        var paymentAddress1 = $('#input-payment-address-1').val();
        if ($('#input-payment-address-1').closest('.required').length || $('#input-payment-address-1').closest('.form-group').hasClass('required')) {
            if (!paymentAddress1 || paymentAddress1.trim().length < 3 || paymentAddress1.trim().length > 128) {
                $('#input-payment-address-1').addClass('is-invalid');
                $('#error-payment-address-1').html('Address must be between 3 and 128 characters!').addClass('d-block');
                $('#input-payment-address-1').closest('.required, .form-group').addClass('has-error');
                errors.push('Payment address is required');
                hasErrors = true;
            }
        }
        
        // City
        var paymentCity = $('#input-payment-city').val();
        if ($('#input-payment-city').closest('.required').length || $('#input-payment-city').closest('.form-group').hasClass('required')) {
            if (!paymentCity || paymentCity.trim().length < 2 || paymentCity.trim().length > 128) {
                $('#input-payment-city').addClass('is-invalid');
                $('#error-payment-city').html('City must be between 2 and 128 characters!').addClass('d-block');
                $('#input-payment-city').closest('.required, .form-group').addClass('has-error');
                errors.push('Payment city is required');
                hasErrors = true;
            }
        }
        
        // Country
        var paymentCountry = $('#input-payment-country').val();
        if ($('#input-payment-country').closest('.required').length || $('#input-payment-country').closest('.form-group').hasClass('required')) {
            if (!paymentCountry || paymentCountry == '' || paymentCountry == '0') {
                $('#input-payment-country').addClass('is-invalid');
                $('#error-payment-country').html('Please select a country!').addClass('d-block');
                $('#input-payment-country').closest('.required, .form-group').addClass('has-error');
                errors.push('Payment country is required');
                hasErrors = true;
            }
        }
        
        // Zone
        var paymentZone = $('#input-payment-zone').val();
        if ($('#input-payment-zone').closest('.required').length || $('#input-payment-zone').closest('.form-group').hasClass('required')) {
            if (!paymentZone || paymentZone == '' || paymentZone == '0') {
                $('#input-payment-zone').addClass('is-invalid');
                $('#error-payment-zone').html('Please select a region / state!').addClass('d-block');
                $('#input-payment-zone').closest('.required, .form-group').addClass('has-error');
                errors.push('Payment zone is required');
                hasErrors = true;
            }
        }
        
        // Postcode (if required)
        if ($('#input-payment-postcode').closest('.required').length || $('#input-payment-postcode').closest('.form-group').hasClass('required')) {
            var paymentPostcode = $('#input-payment-postcode').val();
            if (!paymentPostcode || paymentPostcode.trim().length < 2 || paymentPostcode.trim().length > 10) {
                $('#input-payment-postcode').addClass('is-invalid');
                $('#error-payment-postcode').html('Postcode must be between 2 and 10 characters!').addClass('d-block');
                $('#input-payment-postcode').closest('.required, .form-group').addClass('has-error');
                errors.push('Payment postcode is required');
                hasErrors = true;
            }
        }
    }
    
    // Validate shipping address fields (if shipping is required and address match is not checked)
    var addressMatch = $('#input-address-match').is(':checked');
    if (!$('#input-address-match').length || !addressMatch) {
        if ($('#input-shipping-address-1').length) {
            // Shipping Address 1
            var shippingAddress1 = $('#input-shipping-address-1').val();
            if ($('#input-shipping-address-1').closest('.required').length || $('#input-shipping-address-1').closest('.form-group').hasClass('required')) {
                if (!shippingAddress1 || shippingAddress1.trim().length < 3 || shippingAddress1.trim().length > 128) {
                    $('#input-shipping-address-1').addClass('is-invalid');
                    $('#error-shipping-address-1').html('Address must be between 3 and 128 characters!').addClass('d-block');
                    $('#input-shipping-address-1').closest('.required, .form-group').addClass('has-error');
                    errors.push('Shipping address is required');
                    hasErrors = true;
                }
            }
            
            // Shipping City
            var shippingCity = $('#input-shipping-city').val();
            if ($('#input-shipping-city').closest('.required').length || $('#input-shipping-city').closest('.form-group').hasClass('required')) {
                if (!shippingCity || shippingCity.trim().length < 2 || shippingCity.trim().length > 128) {
                    $('#input-shipping-city').addClass('is-invalid');
                    $('#error-shipping-city').html('City must be between 2 and 128 characters!').addClass('d-block');
                    $('#input-shipping-city').closest('.required, .form-group').addClass('has-error');
                    errors.push('Shipping city is required');
                    hasErrors = true;
                }
            }
            
            // Shipping Country
            var shippingCountry = $('#input-shipping-country').val();
            if ($('#input-shipping-country').closest('.required').length || $('#input-shipping-country').closest('.form-group').hasClass('required')) {
                if (!shippingCountry || shippingCountry == '' || shippingCountry == '0') {
                    $('#input-shipping-country').addClass('is-invalid');
                    $('#error-shipping-country').html('Please select a country!').addClass('d-block');
                    $('#input-shipping-country').closest('.required, .form-group').addClass('has-error');
                    errors.push('Shipping country is required');
                    hasErrors = true;
                }
            }
            
            // Shipping Zone
            var shippingZone = $('#input-shipping-zone').val();
            if ($('#input-shipping-zone').closest('.required').length || $('#input-shipping-zone').closest('.form-group').hasClass('required')) {
                if (!shippingZone || shippingZone == '' || shippingZone == '0') {
                    $('#input-shipping-zone').addClass('is-invalid');
                    $('#error-shipping-zone').html('Please select a region / state!').addClass('d-block');
                    $('#input-shipping-zone').closest('.required, .form-group').addClass('has-error');
                    errors.push('Shipping zone is required');
                    hasErrors = true;
                }
            }
            
            // Shipping Postcode (if required)
            if ($('#input-shipping-postcode').closest('.required').length || $('#input-shipping-postcode').closest('.form-group').hasClass('required')) {
                var shippingPostcode = $('#input-shipping-postcode').val();
                if (!shippingPostcode || shippingPostcode.trim().length < 2 || shippingPostcode.trim().length > 10) {
                    $('#input-shipping-postcode').addClass('is-invalid');
                    $('#error-shipping-postcode').html('Postcode must be between 2 and 10 characters!').addClass('d-block');
                    $('#input-shipping-postcode').closest('.required, .form-group').addClass('has-error');
                    errors.push('Shipping postcode is required');
                    hasErrors = true;
                }
            }
        }
    }
    
    // Validate required custom fields
    $('#form-register .custom-field.required').each(function() {
        var $field = $(this);
        var $input = $field.find('input[type="radio"]:checked, input[type="checkbox"]:checked, select, input[type="text"], input[type="hidden"], textarea').first();
        var fieldValue = $input.val();
        
        // For checkboxes, check if any is checked
        if ($field.find('input[type="checkbox"]').length) {
            fieldValue = $field.find('input[type="checkbox"]:checked').length > 0 ? 'checked' : '';
        }
        
        // For radio buttons, check if any is checked
        if ($field.find('input[type="radio"]').length) {
            fieldValue = $field.find('input[type="radio"]:checked').length > 0 ? $field.find('input[type="radio"]:checked').val() : '';
        }
        
        if (!fieldValue || fieldValue === '' || (Array.isArray(fieldValue) && fieldValue.length === 0)) {
            $input.addClass('is-invalid');
            var errorDiv = $field.find('.invalid-feedback').first();
            if (errorDiv.length) {
                errorDiv.html('This field is required!').addClass('d-block');
            }
            $field.addClass('has-error');
            errors.push('Custom field is required');
            hasErrors = true;
        }
    });
    
    // Validate password if account type is register
    if (isRegister) {
        var password = $('#input-password').val();
        if ($('#input-password').length && ($('#input-password').closest('.required').length || $('#input-password').closest('.form-group').hasClass('required'))) {
            if (!password || password.length < 4) {
                $('#input-password').addClass('is-invalid');
                $('#error-password').html('Password must be at least 4 characters!').addClass('d-block');
                $('#input-password').closest('.required, .form-group').addClass('has-error');
                errors.push('Password is required');
                hasErrors = true;
            }
        }
    }
    
    // Show error alert if there are errors
    if (hasErrors) {
        var errorMessage = 'Please fill in all required fields:<br/>' + errors.slice(0, 5).join('<br/>');
        if (errors.length > 5) {
            errorMessage += '<br/>... and ' + (errors.length - 5) + ' more error(s)';
        }
        $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + errorMessage + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        
        // Scroll to first error
        var firstError = $('#form-register .is-invalid').first();
        if (firstError.length) {
            $('html, body').animate({
                scrollTop: firstError.offset().top - 100
            }, 500);
        }
    }
    
    return !hasErrors;
}

// Function to submit register form
function submitRegisterForm() {
    // Validate all required fields before submission
    if (!validateAllCheckoutFields()) {
        return false; // Don't submit if validation fails
    }

    chain.attach(function () {
        return $.ajax({
            url: 'index.php?route=checkout/register{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}save&language={{ language }}',
            type: 'post',
            dataType: 'json',
            data: $('#form-register').serialize(),
            contentType: 'application/x-www-form-urlencoded',
            beforeSend: function () {
                // Show loading indicator if needed
            },
            complete: function () {
                // Hide loading indicator if needed
            },
            success: function (json) {
                $('#form-register').find('.is-invalid').removeClass('is-invalid');
                $('#form-register').find('.invalid-feedback').removeClass('d-block');
                $('#form-register').find('.has-error').removeClass('has-error');

                console.log(json);

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    if (json['error']['warning']) {
                        $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error']['warning'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                    }

                    for (key in json['error']) {
                        $('#input-' + key.replaceAll('_', '-')).addClass('is-invalid').find('.form-control, .form-select, .form-check-input, .form-check-label').addClass('is-invalid');
                        $('#error-' + key.replaceAll('_', '-')).html(json['error'][key]).addClass('d-block');
                        $('#input-' + key.replaceAll('_', '-')).closest('.required').addClass('has-error');
                    }
                }

                if (json['success']) {
                    $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                    if ($('#input-register').prop('checked')) {
                        $('input[name=\'account\']').prop('disabled', true);
                        $('#input-customer-group').prop('disabled', true);
                        $('#input-password').prop('disabled', true);
                        $('#input-captcha').prop('disabled', true);
                    }

                    // Auto-load shipping and payment methods
                    loadShippingAndPaymentMethods();
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
}

// Function to load shipping and payment methods
function loadShippingAndPaymentMethods() {
    {% if shipping_required %}
        // Load shipping methods first
        setTimeout(function() {
            if ($('#button-shipping-method').length) {
                $('#button-shipping-method').trigger('click');
            } else {
                // If button doesn't exist, load directly via AJAX
                chain.attach(function () {
                    return $.ajax({
                        url: 'index.php?route=checkout/shipping_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}getMethods&language={{ language }}',
                        dataType: 'json',
                        success: function (json) {
                            if (json['redirect']) {
                                location = json['redirect'];
                                return;
                            }
                            if (json['error']) {
                                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                            }
                            if (json['shipping_methods']) {
                                // Reload shipping method section to show methods
                                $('#checkout-shipping-method').load('index.php?route=checkout/shipping_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}index&language={{ language }}', function() {
                                    // After shipping methods load, wait a bit then load payment methods
                                    setTimeout(function() {
                                        loadPaymentMethods();
                                    }, 500);
                                });
                            } else {
                                // No shipping methods, try payment methods anyway
                                setTimeout(function() {
                                    loadPaymentMethods();
                                }, 500);
                            }
                        },
                        error: function() {
                            // On error, still try to load payment methods
                            setTimeout(function() {
                                loadPaymentMethods();
                            }, 500);
                        }
                    });
                });
            }
        }, 500);
    {% else %}
        // No shipping required, load payment methods directly
        setTimeout(function() {
            loadPaymentMethods();
        }, 500);
    {% endif %}
}

// Function to load payment methods
function loadPaymentMethods() {
    setTimeout(function() {
        if ($('#button-payment-method').length) {
            $('#button-payment-method').trigger('click');
        } else {
            chain.attach(function () {
                return $.ajax({
                    url: 'index.php?route=checkout/payment_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}getMethods&language={{ language }}',
                    dataType: 'json',
                    success: function (json) {
                        if (json['redirect']) {
                            location = json['redirect'];
                            return;
                        }
                        if (json['error']) {
                            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                        }
                        if (json['payment_methods']) {
                            // Reload payment method section to show methods
                            $('#checkout-payment-method').load('index.php?route=checkout/payment_method{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}index&language={{ language }}', function() {
                                // Reload confirm section after payment methods load
                                setTimeout(function() {
                                    $('#checkout-confirm').load('index.php?route=checkout/confirm{{ constant('JOURNAL3_ROUTE_SEPARATOR') }}confirm&language={{ language }}');
                                }, 300);
                            });
                        }
                    },
                    error: function() {
                        console.log('Error loading payment methods');
                    }
                });
            });
        }
    }, 300);
}

