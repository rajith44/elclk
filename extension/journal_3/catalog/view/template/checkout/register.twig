});

// Auto-load shipping and payment methods on page load
$(document).ready(function() {
    // Function to check and load methods
    function checkAndLoadMethods() {
        // Check if form has enough data to load methods
        var hasPaymentCity = $('#input-payment-city').val() && $('#input-payment-city').val().trim() !== '';
        var hasPaymentCountry = $('#input-payment-country').val() && $('#input-payment-country').val() !== '';
        var hasPaymentZone = $('#input-payment-zone').val() && $('#input-payment-zone').val() !== '';
        var hasPaymentAddress1 = $('#input-payment-address-1').val() && $('#input-payment-address-1').val().trim() !== '';
        var hasPaymentPostcode = $('#input-payment-postcode').val() && $('#input-payment-postcode').val().trim() !== '';
        
        {% if shipping_required %}
        var hasShippingCity = $('#input-shipping-city').val() && $('#input-shipping-city').val().trim() !== '';
        var hasShippingCountry = $('#input-shipping-country').val() && $('#input-shipping-country').val() !== '';
        var hasShippingZone = $('#input-shipping-zone').val() && $('#input-shipping-zone').val() !== '';
        var hasShippingAddress1 = $('#input-shipping-address-1').val() && $('#input-shipping-address-1').val().trim() !== '';
        var hasShippingPostcode = $('#input-shipping-postcode').val() && $('#input-shipping-postcode').val().trim() !== '';
        
        // Check if shipping address is complete
        var shippingComplete = hasShippingCity && hasShippingCountry && hasShippingZone && hasShippingAddress1 && hasShippingPostcode;
        // Check if payment address is complete
        var paymentComplete = hasPaymentCity && hasPaymentCountry && hasPaymentZone && hasPaymentAddress1 && hasPaymentPostcode;
        
        if (shippingComplete) {
            // Shipping address complete - submit form and load methods
            submitRegisterForm();
        } else if (paymentComplete) {
            // Payment address complete - submit form and try to load methods
            submitRegisterForm();
        }
        {% else %}
        // No shipping required, just need payment address
        var paymentComplete = hasPaymentCity && hasPaymentCountry && hasPaymentZone && hasPaymentAddress1 && hasPaymentPostcode;
        
        if (paymentComplete) {
            submitRegisterForm();
        }
        {% endif %}
    }
    
    // Try immediately after a short delay
    setTimeout(checkAndLoadMethods, 500);
    
    // Try again after page fully loads
    setTimeout(checkAndLoadMethods, 1500);
    
    // Try once more after all scripts load
    setTimeout(checkAndLoadMethods, 2500);
    
    // Also try when country/zone selects are populated (they load dynamically)
    $(document).on('DOMNodeInserted', function() {
        setTimeout(checkAndLoadMethods, 100);
    });
});
