{{ header }}
{% if journal3.get('pageTitlePosition') == 'top' %}
  <h1 class="title page-title {{ journal3.get('title_color_scheme') }}"><span class="page-title-text">{{ heading_title }}</span></h1>
{% endif %}
<div class="breadcrumbs {{ journal3.get('breadcrumbs_color_scheme') }}">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
</div>
{{ journal3_top }}
<div id="checkout-checkout" class="container">
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      {% if journal3.get('pageTitlePosition') == 'default' %}
        <h1 class="title page-title {{ journal3.get('title_color_scheme') }}">{{ heading_title }}</h1>
      {% endif %}
      <div class="row checkout-sections">
        {% if register or payment_address or shipping_address %}
        <div class="col-md-7 mb-3 checkout-section checkout-section-start">

          {% if register %}
            <div id="checkout-register">{{ register }}</div>
          {% endif %}

          {% if payment_address %}
            <div id="checkout-payment-address">{{ payment_address }}</div>
          {% endif %}

          {% if shipping_address %}
            <div id="checkout-shipping-address">{{ shipping_address }}</div>
          {% endif %}

        </div>
        {% endif %}
        <div class="col-md-5 checkout-section checkout-section-end">
          {% if shipping_method %}
            <div id="checkout-shipping-method" class="mb-3">{{ shipping_method }}</div>
          {% endif %}
          <div id="checkout-payment-method" class="mb-4">{{ payment_method }}</div>

          <div id="checkout-confirm">{{ confirm }}</div>

        </div>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
<script type="text/javascript"><!--
// Auto-load shipping and payment methods on checkout page load
$(document).ready(function() {
    // Wait for all sections to load
    setTimeout(function() {
        // Check if shipping method section exists and is empty or needs refresh
        var shippingMethodSection = $('#checkout-shipping-method');
        var paymentMethodSection = $('#checkout-payment-method');
        
        // Function to load shipping methods
        function loadShippingMethods() {
            // Check if cart has shipping required
            var hasShipping = shippingMethodSection.length > 0;
            
            if (hasShipping) {
                // Check if shipping methods button exists
                if ($('#button-shipping-method').length) {
                    // Trigger the button to load methods
                    $('#button-shipping-method').trigger('click');
                } else {
                    // Load shipping methods directly
                    var routeSep = typeof JOURNAL3_ROUTE_SEPARATOR !== 'undefined' ? JOURNAL3_ROUTE_SEPARATOR : '/';
                    var lang = $('html').attr('lang') || 'en-gb';
                    shippingMethodSection.load('index.php?route=checkout/shipping_method' + routeSep + 'index&language=' + lang, function() {
                        // After shipping methods load, load payment methods
                        setTimeout(loadPaymentMethods, 500);
                    });
                }
            } else {
                // No shipping required, load payment methods directly
                loadPaymentMethods();
            }
        }
        
        // Function to load payment methods
        function loadPaymentMethods() {
            if (paymentMethodSection.length) {
                // Check if payment methods button exists
                if ($('#button-payment-method').length) {
                    // Trigger the button to load methods
                    $('#button-payment-method').trigger('click');
                } else {
                    // Load payment methods directly
                    var routeSep = typeof JOURNAL3_ROUTE_SEPARATOR !== 'undefined' ? JOURNAL3_ROUTE_SEPARATOR : '/';
                    var lang = $('html').attr('lang') || 'en-gb';
                    paymentMethodSection.load('index.php?route=checkout/payment_method' + routeSep + 'index&language=' + lang, function() {
                        // After payment methods load, reload confirm section
                        setTimeout(function() {
                            $('#checkout-confirm').load('index.php?route=checkout/confirm' + routeSep + 'confirm&language=' + lang);
                        }, 300);
                    });
                }
            }
        }
        
        // Check if address data exists in form (indicating session has data)
        var hasAddressData = false;
        
        // Check shipping address (if shipping section exists)
        if (shippingMethodSection.length) {
            var hasShippingData = $('#input-shipping-city').val() || $('#input-shipping-country').val() || $('#input-shipping-zone').val();
            if (hasShippingData) {
                hasAddressData = true;
            }
        }
        
        // Check payment address
        var hasPaymentData = $('#input-payment-city').val() || $('#input-payment-country').val() || $('#input-payment-zone').val();
        if (hasPaymentData) {
            hasAddressData = true;
        }
        
        // If address data exists, try to load methods
        if (hasAddressData) {
            // Wait a bit more for form to be fully initialized
            setTimeout(function() {
                loadShippingMethods();
            }, 1000);
        }
    }, 2000);
});
//--></script>
{{ footer }}
