<link rel="stylesheet" href="{{ base }}extension/instagram_feed/catalog/view/stylesheet/instagram_feed.css">
<section class="ig-feed ig-feed--cols-{{ columns }}" aria-label="{{ title }}">
  <div class="ig-feed__header">
    <div class="ig-feed__title-wrap">
      <span class="ig-feed__icon" aria-hidden="true"><i class="fa-brands fa-instagram"></i></span>
      <div>
        <h2 class="ig-feed__title">{{ title }}</h2>
        {% if username %}
          <p class="ig-feed__username">@{{ username }}</p>
        {% endif %}
      </div>
    </div>
    {% if show_follow %}
      <a class="ig-feed__follow" href="{{ profile_url }}" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-instagram" aria-hidden="true"></i>
        <span>{{ text_follow }}</span>
      </a>
    {% endif %}
  </div>

  <div class="ig-feed__grid">
    {% for post in posts %}
      <a class="ig-feed__item" href="{{ post.permalink }}" target="_blank" rel="noopener noreferrer" aria-label="{{ text_view }}">
        <img src="{{ post.image }}" alt="" loading="lazy" width="400" height="400">
        <span class="ig-feed__overlay">
          {% if post.media_type == 'VIDEO' %}
            <span class="ig-feed__type"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
          {% elseif post.media_type == 'CAROUSEL_ALBUM' %}
            <span class="ig-feed__type"><i class="fa-solid fa-images" aria-hidden="true"></i></span>
          {% endif %}
          {% if show_stats %}
            <span class="ig-feed__stats">
              <span><i class="fa-solid fa-heart" aria-hidden="true"></i> {{ post.like_count }}</span>
              <span><i class="fa-solid fa-comment" aria-hidden="true"></i> {{ post.comments_count }}</span>
            </span>
          {% endif %}
          {% if show_caption and post.caption %}
            <span class="ig-feed__caption">{{ post.caption }}</span>
          {% endif %}
          <span class="ig-feed__view"><i class="fa-brands fa-instagram" aria-hidden="true"></i> {{ text_view }}</span>
        </span>
      </a>
    {% endfor %}
  </div>
</section>
