<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{{ subject }}</title>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background-color: #f8f9fa; padding: 20px; text-align: center; }
    .content { padding: 20px; background-color: #ffffff; }
    .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 20px 0; }
    .product-item { border: 1px solid #ddd; padding: 15px; text-align: center; }
    .product-item img { max-width: 100%; height: auto; margin-bottom: 10px; }
    .product-name { font-weight: bold; margin-bottom: 10px; }
    .product-price { margin-bottom: 10px; }
    .original-price { text-decoration: line-through; color: #888; }
    .promotion-price { color: #e74c3c; font-weight: bold; font-size: 1.2em; }
    .btn { display: inline-block; padding: 10px 20px; background-color:rgba(252, 108, 133, 1); color: #fff; text-decoration: none; border-radius: 5px; margin-top: 10px; }
    .footer { text-align: center; padding: 20px; font-size: 12px; color: #666; }
    .unsubscribe { margin-top: 20px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{{ store_name }}</h1>
    </div>
    <div class="content">
      <div>{% autoescape false %}{{ message }}{% endautoescape %}</div>
      
      {% if products %}
        <h2>Featured Products with Promotions:</h2>
        <div class="product-grid">
          {% for product in products %}
            <div class="product-item">
              {% if product.image %}
                <img src="{{ product.image }}" alt="{{ product.name }}" style="max-width: 200px; height: auto; display: block; margin: 0 auto 10px;"/>
              {% endif %}
              <div class="product-name">{{ product.name }}</div>
              <div class="product-price">
                {% if product.has_promotion %}
                  <span class="original-price">{{ product.price }}</span>
                  <span class="promotion-price">{{ product.promotion_price }}</span>
                {% else %}
                  <span>{{ product.price }}</span>
                {% endif %}
              </div>
              <a href="{{ product.href }}" class="btn">View Product</a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="footer">
      <p>{{ store_name }}<br>{{ store_url }}</p>
      <div class="unsubscribe">
        <a href="{{ unsubscribe }}">Unsubscribe from this newsletter</a>
      </div>
    </div>
  </div>
</body>
</html>

