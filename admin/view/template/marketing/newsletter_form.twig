{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-newsletter" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
      <div class="card-body">
        <form id="form-newsletter" action="{{ save }}" method="post" data-oc-toggle="ajax">
          {% if campaign.campaign_id %}
            <input type="hidden" name="campaign_id" value="{{ campaign.campaign_id }}"/>
          {% endif %}
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ tab_general }}</a></li>
            <li class="nav-item"><a href="#tab-products" data-bs-toggle="tab" class="nav-link">{{ tab_products }}</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3 required">
                <label for="input-name" class="col-sm-2 col-form-label">{{ entry_name }}</label>
                <div class="col-sm-10">
                  <input type="text" name="name" value="{{ campaign.name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
                  <div id="error-name" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-send-to" class="col-sm-2 col-form-label">{{ entry_send_to }}</label>
                <div class="col-sm-10">
                  <select name="send_to_type" id="input-send-to" class="form-select">
                    <option value="all_customers"{% if campaign.send_to_type == 'all_customers' %} selected{% endif %}>{{ text_all_customers }}</option>
                    <option value="customer_groups"{% if campaign.send_to_type == 'customer_groups' %} selected{% endif %}>{{ text_customer_groups }}</option>
                    <option value="subscribers"{% if campaign.send_to_type == 'subscribers' or not campaign.send_to_type %} selected{% endif %}>{{ text_newsletter_subscribers }}</option>
                    <option value="custom"{% if campaign.send_to_type == 'custom' %} selected{% endif %}>{{ text_custom }}</option>
                  </select>
                  <div id="error-send-to" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3" id="customer-groups-group" style="{% if campaign.send_to_type != 'customer_groups' %}display: none;{% endif %}">
                <label for="input-customer-groups" class="col-sm-2 col-form-label">{{ entry_customer_groups }}</label>
                <div class="col-sm-10">
                  <select name="customer_group_ids[]" id="input-customer-groups" class="form-select" multiple size="5">
                    {% for customer_group in customer_groups %}
                      <option value="{{ customer_group.customer_group_id }}"{% if customer_group.customer_group_id in campaign.customer_group_ids %} selected{% endif %}>{{ customer_group.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="form-text">{{ help_customer_groups }}</div>
                </div>
              </div>
              <div class="row mb-3" id="custom-emails-group" style="{% if campaign.send_to_type != 'custom' %}display: none;{% endif %}">
                <label for="input-custom-emails" class="col-sm-2 col-form-label">{{ entry_custom_emails }}</label>
                <div class="col-sm-10">
                  <textarea name="custom_emails" id="input-custom-emails" class="form-control" rows="5" placeholder="{{ help_custom_emails }}">{{ campaign.custom_emails }}</textarea>
                  <div class="form-text">{{ help_custom_emails }}</div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-subject" class="col-sm-2 col-form-label">{{ entry_subject }}</label>
                <div class="col-sm-10">
                  <input type="text" name="subject" value="{{ campaign.subject }}" placeholder="{{ entry_subject }}" id="input-subject" class="form-control"/>
                  <div id="error-subject" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
                <div class="col-sm-10">
                  <textarea name="message" placeholder="{{ entry_message }}" id="input-message" class="form-control" rows="10">{{ campaign.message }}</textarea>
                  <div id="error-message" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="status" value="0"/>
                    <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if campaign.status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
            </div>
            <div id="tab-products" class="tab-pane">
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_products }}</label>
                <div class="col-sm-10">
                  <div class="mb-2">
                    <input type="text" id="product-search" placeholder="Search products..." class="form-control" style="max-width: 300px;"/>
                  </div>
                  <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-bordered table-hover" id="product-table">
                      <thead>
                        <tr>
                          <td width="1" class="text-center"><input type="checkbox" onclick="$('input[name*=\'product_ids\']').prop('checked', this.checked);"/></td>
                          <td class="text-center">{{ column_image }}</td>
                          <td class="text-start">{{ column_name }}</td>
                          <td class="text-start">{{ column_price }}</td>
                          <td class="text-start">{{ column_promotion }}</td>
                        </tr>
                      </thead>
                      <tbody>
                        {% if products %}
                          {% for product in products %}
                            <tr class="product-row">
                              <td class="text-center"><input type="checkbox" name="product_ids[]" value="{{ product.product_id }}"{% if product.product_id in campaign.product_ids %} checked{% endif %}/></td>
                              <td class="text-center"><img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" style="max-width: 80px;"/></td>
                              <td class="text-start">{{ product.name }}</td>
                              <td class="text-start">
                                {% if product.has_promotion %}
                                  <span style="text-decoration: line-through; color: #888;">{{ product.price }}</span>
                                  <span style="font-weight: bold; color: #e74c3c; margin-left: 5px;">{{ product.promotion_price }}</span>
                                {% else %}
                                  {{ product.price }}
                                {% endif %}
                              </td>
                              <td class="text-start">
                                {% if product.has_promotion %}
                                  <span class="badge bg-success">{{ text_yes }}</span>
                                {% else %}
                                  <span class="badge bg-secondary">{{ text_no }}</span>
                                {% endif %}
                              </td>
                            </tr>
                          {% endfor %}
                        {% else %}
                          <tr>
                            <td class="text-center" colspan="5">{{ text_no_results }}</td>
                          </tr>
                        {% endif %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
$(document).ready(function() {
  $('#input-message').ckeditor();
  
  // Product search filter
  $('#product-search').on('keyup', function() {
    var value = $(this).val().toLowerCase();
    $('#product-table tbody tr.product-row').filter(function() {
      $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
    });
  });
  
  // Show/hide conditional fields based on send_to_type
  $('#input-send-to').on('change', function() {
    var sendToType = $(this).val();
    if (sendToType == 'customer_groups') {
      $('#customer-groups-group').show();
      $('#custom-emails-group').hide();
    } else if (sendToType == 'custom') {
      $('#customer-groups-group').hide();
      $('#custom-emails-group').show();
    } else {
      $('#customer-groups-group').hide();
      $('#custom-emails-group').hide();
    }
  });
});
</script>
{{ footer }}

